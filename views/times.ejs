<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Lista de Times</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <header class="site-header">
        <a class="brand" href="/">Catálogo de Times</a>
        <nav aria-label="Navegação principal">
            <a href="/">Início</a>
            <a href="/times" aria-current="page">Times</a>
        </nav>
    </header>
    <main class="container">
        <div class="page-heading">
            <p class="eyebrow">Catálogo</p>
            <h1>Times</h1>
            <p>Confira os clubes cadastrados e veja mais informações sobre cada um.</p>
        </div>

        <% if (listaTimes && listaTimes.length > 0) { %>
            <div class="table-wrap">
                <table>
                    <caption>Times cadastrados</caption>
                    <thead>
                        <tr>
                            <th scope="col">Nome</th>
                            <th scope="col">Estádio</th>
                            <th scope="col">Cidade</th>
                            <th scope="col"><span class="sr-only">Ação</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% listaTimes.forEach(time => { %>
                            <tr>
                                <th scope="row"><%= time.nome %></th>
                                <td><%= time.estadio %></td>
                                <td><%= time.cidade %></td>
                                <td><a href="/times/<%= time.id %>" aria-label="Ver detalhes de <%= time.nome %>">Ver detalhes</a></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <p class="empty-state">Nenhum time cadastrado no momento.</p>
        <% } %>
    </main>
</body>
</html>